# docker-compose overrides. Copy to .env.
AIRFLOW_UID=50000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Production-style run: Spark on Databricks, dbt on a Databricks SQL warehouse, real S3 ---
# PIPELINE_COMPUTE=databricks
# DBT_TARGET=databricks
# S3_ENDPOINT_URL=
# INCOMING_URI=s3://walmart-retail-dev-landing-<account-id>/incoming
# LAKEHOUSE_URI=s3://walmart-retail-dev-lakehouse-<account-id>
# UC_CATALOG=walmart_retail_dev
# DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
# DATABRICKS_TOKEN=dapi...   (prefer a service principal / Secrets Manager backend)
# AIRFLOW_CONN_DATABRICKS_DEFAULT={"conn_type":"databricks","host":"https://dbc-...","password":"dapi..."}
# ALERT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<account-id>:walmart-retail-dev-pipeline-alerts
